# انسخ هذا الملف إلى .env وضع فيه قيم مشروعك من Firebase Console
# (Project settings > General > Your apps > Web app > Config)
# هذه القيم عامة بطبيعتها وليست سرية؛ الحماية تعتمد على Auth وFirestore Rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# اختياري: للاتصال بالمحاكيات المحلية أثناء التطوير
# VITE_USE_EMULATORS=true
